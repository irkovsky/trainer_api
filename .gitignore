# ============================================================
# PYTHON
# ============================================================

# Кэш скомпилированных Python-файлов
__pycache__/

# Скомпилированные файлы Python (bytecode)
*.py[cod]

# Метаданные пакетов
*.egg-info/
*.egg

# Кэш pytest
.pytest_cache/

# Кэш mypy
.mypy_cache/

# Кэш coverage
.coverage
htmlcov/
coverage.xml


# ============================================================
# DJANGO
# ============================================================

# Логи Django
*.log

# Локальная база SQLite
db.sqlite3
db.sqlite3-journal

# Загруженные пользователем файлы (медиа)
/media/

# Собранная статика (если используете collectstatic)
/staticfiles/

# Секретный ключ и настройки окружения
.env
.env.local
.env.*.local


# ============================================================
# ВИРТУАЛЬНОЕ ОКРУЖЕНИЕ
# ============================================================

# Папка виртуального окружения (создаётся через python -m venv)
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/


# ============================================================
# IDE / РЕДАКТОРЫ
# ============================================================

# VS Code
.vscode/

# PyCharm / IntelliJ
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace


# ============================================================
# ОПЕРАЦИОННЫЕ СИСТЕМЫ
# ============================================================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

